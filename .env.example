# Local mode: SQLite + uploaded images live in data/live.
# Production MUST set MEDIA_STORAGE_PROVIDER explicitly; there is no local fallback.
# MEDIA_STORAGE_PROVIDER=local
# Current production uses r2 after the locked cutover on 2026-10-21.
PORT=4173
# NODE_ENV=production
# SITE_URL=https://chicongphoto.vn
# Isolated staging: prevent indexing and exclude synthetic traffic from analytics.
# SITE_INDEXING=false
# ANALYTICS_ENABLED=false
# Local LAN access requires an explicit origin, e.g. SITE_URL=http://192.168.1.25:4173
# Production requires an HTTPS SITE_URL; POST/PUT/PATCH/DELETE only accept this origin.
# TRUST_PROXY defaults to 1 in production (existing Render topology), false locally.
# Override only after verifying the proxy chain: false, a hop count, or trusted IPs/CIDRs.
# Never use true. Do not trust client-supplied CF-Connecting-IP/X-Forwarded-For directly.
# TRUST_PROXY=1
# DATABASE_URL=postgresql://postgres.PROJECT:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# Set this in the shell or hosting environment before Node starts.
# NODE_EXTRA_CA_CERTS=./certs/supabase-root-2021.crt
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_LEGACY_SERVICE_ROLE_JWT
# SUPABASE_BUCKET=chicong-private
# SETUP_TOKEN=YOUR_RANDOM_ONE_TIME_SETUP_SECRET

# Email notification (Resend API or SMTP):
# RESEND_API_KEY=re_your_api_key_here
# NOTIFICATION_EMAIL=info@chicongphoto.vn
# EMAIL_FROM=ChiCong Studio <onboarding@resend.dev>
# SMTP options (alternative to Resend):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_SECURE=false

# Server-only Google Calendar secret iCal URL (read-only Google -> Studio).
# GOOGLE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/ACCOUNT/private-SECRET/basic.ics

# Count every non-cancelled event, including Google events marked Free.
# GOOGLE_CALENDAR_INCLUDE_FREE=true

# R2 runtime only (database stays on DATABASE_URL; Supabase Storage keys are not needed):
# MEDIA_STORAGE_PROVIDER=r2
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET=chicong-production
# R2_ACCESS_KEY_ID=SERVER_ONLY_ACCESS_KEY
# R2_SECRET_ACCESS_KEY=SERVER_ONLY_SECRET
# MEDIA_CLEANUP_ENABLED=false  # isolated restore/staging until verified

# Runner ONLY: never add Drive credentials to the website runtime.
# BACKUP_DRIVE_CLIENT_ID=GOOGLE_DESKTOP_OAUTH_CLIENT_ID
# BACKUP_DRIVE_CLIENT_SECRET=GOOGLE_OAUTH_CLIENT_SECRET
# BACKUP_DRIVE_REFRESH_TOKEN=OFFLINE_REFRESH_TOKEN
# BACKUP_DRIVE_ACCOUNT_EMAIL=OWNER_SELECTED_DURING_OAUTH
# BACKUP_DRIVE_FOLDER_ID=FOLDER_CREATED_BY_MEDIA_OPS_DRIVE_INIT
# For copy/switch only, use TARGET_MEDIA_STORAGE_PROVIDER and TARGET_R2_* or
# TARGET_SUPABASE_* variables. Secrets remain outside Git and chat.

# Google Drive source sync: separate service account, never backup OAuth.
# Web and worker use the same database and storage identity. Both gates default off.
# DRIVE_SYNC_ENABLED=false
# DRIVE_SYNC_SCHEDULER_ENABLED=false
# Worker ONLY: absolute path to service-account JSON, permissions 0600.
# DRIVE_SYNC_SERVICE_ACCOUNT_FILE=/absolute/private/path/drive-sync-service-account.json
# DRIVE_SYNC_INTERVAL_MS=900000
# DRIVE_SYNC_POLL_MS=5000
# DRIVE_SYNC_BATCH_SIZE=5
# DRIVE_SYNC_MAX_INVENTORY_FILES=20000
# JPEG bootstrap bounds; measure real samples before raising these limits.
# PNG/WebP retain the manual 20 MiB and 40 MP limit.
# DRIVE_SYNC_MAX_SOURCE_BYTES=134217728
# DRIVE_SYNC_MAX_SOURCE_PIXELS=120000000
# DRIVE_SYNC_ENCODE_TIMEOUT_MS=120000
# DRIVE_SYNC_REQUEST_TIMEOUT_MS=120000
# DRIVE_SYNC_TEMP_DIR=/private/tmp/chicong-drive-sync
