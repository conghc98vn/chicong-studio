# Local mode: leave cloud variables unset. SQLite + uploaded images live in data/live.
PORT=4173
# NODE_ENV=production
# SITE_URL=https://chicongphoto.vn
# Local LAN access requires an explicit origin, e.g. SITE_URL=http://192.168.1.25:4173
# Production requires an HTTPS SITE_URL; POST/PUT/PATCH/DELETE only accept this origin.
# TRUST_PROXY defaults to 1 in production (existing Render topology), false locally.
# Override only after verifying the proxy chain: false, a hop count, or trusted IPs/CIDRs.
# Never use true. Do not trust client-supplied CF-Connecting-IP/X-Forwarded-For directly.
# TRUST_PROXY=1
# DATABASE_URL=postgresql://postgres.PROJECT:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# Set this in the shell or hosting environment before Node starts.
# NODE_EXTRA_CA_CERTS=./certs/supabase-root-2021.crt
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_LEGACY_SERVICE_ROLE_JWT
# SUPABASE_BUCKET=chicong-private
# SETUP_TOKEN=YOUR_RANDOM_ONE_TIME_SETUP_SECRET

# Email notification (Resend API or SMTP):
# RESEND_API_KEY=re_your_api_key_here
# NOTIFICATION_EMAIL=info@chicongphoto.vn
# EMAIL_FROM=ChiCong Studio <onboarding@resend.dev>
# SMTP options (alternative to Resend):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_SECURE=false

# Server-only Google Calendar secret iCal URL (read-only Google -> Studio).
# GOOGLE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/ACCOUNT/private-SECRET/basic.ics

# Count every non-cancelled event, including Google events marked Free.
# GOOGLE_CALENDAR_INCLUDE_FREE=true
