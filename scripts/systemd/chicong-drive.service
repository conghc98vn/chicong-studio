[Unit]
Description=ChiCong Google Drive sync worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=chicong-drive
Group=chicong-drive
WorkingDirectory=/var/www/chicongphoto
EnvironmentFile=/etc/chicongphoto/drive-worker.env
ExecStart=/usr/bin/node --max-old-space-size=256 /var/www/chicongphoto/studio/tools/drive-sync.mjs worker
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=90
UMask=0077
StateDirectory=chicong-drive
StateDirectoryMode=0700
ReadWritePaths=/var/lib/chicong-drive
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CPUAccounting=true
CPUQuota=50%
MemoryAccounting=true
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=256M
TasksMax=64
OOMPolicy=stop
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chicong-drive

[Install]
WantedBy=multi-user.target
